# Copy to .env and adjust. Every variable has a working default for the layout described in the README, so .env is optional.

# --- Studio API --------------------------------------------------------------
# Loopback only. The API has no authentication: do not expose it.
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Browser origins allowed to call the API (comma-separated). Vite dev server by default.
WEB_ORIGIN=http://localhost:5173
# Where project folders are stored (relative paths resolve from the repo root).
PROJECTS_DIR=./projects
LOG_LEVEL=info

# --- Ollama (scene planning) -------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=240000
OLLAMA_RETRIES=1
OLLAMA_TEMPERATURE=0.7
# How long to wait for Ollama to really release its model before the pipeline refuses to continue
OLLAMA_UNLOAD_TIMEOUT_MS=20000
# Repair rounds when the model returns invalid JSON / breaks the plan rules
PLANNER_MAX_REPAIR_ATTEMPTS=2

# --- ComfyUI (image generation; started on demand, once per project batch) ----
COMFYUI_DIR=./comfyui
COMFYUI_PYTHON=./venv-comfy/bin/python
COMFYUI_PORT=8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
COMFYUI_LORA=lcm-lora-sdv1-5.safetensors
COMFYUI_START_TIMEOUT_MS=180000
COMFYUI_IMAGE_TIMEOUT_MS=600000
COMFYUI_STOP_TIMEOUT_MS=20000

# --- Piper (voices; separate process) -----------------------------------------
PIPER_PYTHON=./venv-piper/bin/python
PIPER_VOICES_DIR=./piper-voices
PIPER_TIMEOUT_MS=60000

# --- FFmpeg --------------------------------------------------------------------
# Leave empty to auto-detect on PATH / Homebrew.
FFMPEG_PATH=
FFPROBE_PATH=
# auto = h264_videotoolbox with a libx264 software fallback; or force one encoder
FFMPEG_ENCODER=auto
FFMPEG_TIMEOUT_MS=600000

# --- Subtitles (macOS CoreText helper built by `npm run build:native`) ---------
SUBTITLE_HELPER=./bin/subpng

# Warn (never block) before image generation when macOS reports less free memory than this (%)
MEMORY_WARN_FREE_PERCENT=30

# DreamShaper 8 split components (cinematic profile): files in comfyui/models/{diffusion_models,text_encoders,vae}
# COMFYUI_DS8_UNET=dreamshaper8_unet_fp16.safetensors
# COMFYUI_DS8_CLIP=dreamshaper8_clip_fp16.safetensors
# COMFYUI_DS8_VAE=dreamshaper8_vae_fp16.safetensors
